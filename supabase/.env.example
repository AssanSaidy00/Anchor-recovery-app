# Copy to supabase/.env for local runs (supabase functions serve --env-file supabase/.env).
# For the deployed project, set these with:  supabase secrets set --env-file supabase/.env
# SUPABASE_URL and SUPABASE_ANON_KEY are provided to Edge Functions automatically.
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=paste-the-token-from-the-upstash-console
